[submodule "vendor/ogg"]
	path = vendor/ogg
	url = https://github.com/xiph/ogg.git
	branch = master
[submodule "vendor/opus"]
	path = vendor/opus
	url = https://github.com/xiph/opus.git
	branch = master
[submodule "vendor/opusfile"]
	path = vendor/opusfile
	url = https://github.com/xiph/opusfile.git
	branch = master
[submodule "lib"]
	path = lib
	url = https://github.com/klaymen1n/revc-android-3rdparty-libs
[submodule "vendor/glfw"]
	path = vendor/glfw
	url = https://github.com/kunitoki/glfw.git
[submodule "vendor/openal-soft"]
	path = vendor/openal-soft
	url = https://github.com/kcat/openal-soft.git
[submodule "vendor/mpg123"]
	path = vendor/mpg123
	url = https://github.com/boludoz/mpg123.git
[submodule "vendor/SDL3"]
	path = vendor/SDL3
	url = https://github.com/libsdl-org/SDL.git
	branch = main
[submodule "vendor/librw"]
	path = vendor/librw
	url = https://github.com/boludoz/librw.git
	branch = master
